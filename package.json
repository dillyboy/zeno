{
  "name": "zeno-backend",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts --open",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "check": "vp check",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "test:watch": "vp test watch"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/jwt": "^10.2.4",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "bcryptjs": "^3.0.3",
    "dayjs": "^1.11.23",
    "fastify": "^5.12.7",
    "mongoose": "^9.11.2",
    "open": "^11.0.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite-plus": "^1.3.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
