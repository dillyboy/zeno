HOST=127.0.0.1
PORT=3000
MONGODB_URI=
JWT_SECRET=

# Session limits in milliseconds (15 minutes idle, 8 hours absolute).
SESSION_IDLE_TIMEOUT_MS=900000
SESSION_ABSOLUTE_LIFETIME_MS=28800000
# Token and matching cookie lifetimes in seconds.
ACCESS_TOKEN_LIFETIME_SECONDS=900
REFRESH_TOKEN_LIFETIME_SECONDS=86400
# MongoDB time limits in milliseconds.
DATABASE_SELECTION_TIMEOUT_MS=10000
DATABASE_QUERY_TIMEOUT_MS=10000

# Exact browser origins allowed for authentication and mutations. No wildcards.
CSRF_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:6006,http://127.0.0.1:6006
